# Copy to server/.env for running the API outside Docker (npm run dev).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Docker MongoDB. directConnection is needed from the host because the
# replica set member advertises itself as "mongo:27017", which only resolves inside Docker.
MONGO_URI=mongodb://localhost:27017/ticketrush?directConnection=true

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

REDIS_URL=redis://localhost:6379

# Background jobs (the worker: npm run worker)
QUEUE_PREFIX=bull
SWEEP_INTERVAL_SECONDS=60
SWEEP_BATCH_SIZE=500
EMAIL_BACKOFF_BASE_MS=1000

# Email. Leave SMTP_URL unset to log emails instead of sending them.
# SMTP_URL=smtps://user:pass@smtp.example.com
MAIL_FROM=TicketRush <no-reply@ticketrush.local>

# Holds (SRS 2.4)
HOLD_TTL_SECONDS=300
MAX_ACTIVE_HOLDS_PER_EVENT=2

# Simulated payment (FR-12): chance a payment succeeds, and how long it takes
PAYMENT_SUCCESS_RATE=0.9
PAYMENT_DELAY_MS=200

# Rate limits (SRS 8.3), requests per RATE_LIMIT_WINDOW_SECONDS. Set RATE_LIMIT_IP_ENABLED=false for k6.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# RL_ALL_USER=120
# RL_ALL_IP=300
# RL_AUTH_IP=10
# RL_HOLD_USER=10
# RL_HOLD_IP=30
# RL_CONFIRM_USER=10
# RL_CONFIRM_IP=30
# Number of reverse proxies in front of the API (0 locally, usually 1 when deployed)
TRUST_PROXY=0

CORS_ORIGIN=http://localhost:5173
# Defaults to true in production. Browsers accept Secure cookies on http://localhost.
# COOKIE_SECURE=false

# Used only by: npm run seed:admin
ADMIN_EMAIL=admin@ticketrush.local
ADMIN_PASSWORD=change-me-admin-password
