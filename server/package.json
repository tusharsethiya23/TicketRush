{
  "name": "ticketrush-server",
  "version": "0.1.0",
  "description": "TicketRush API and worker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "dev:worker": "node --watch src/worker.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "globalTeardown": "./tests/globalTeardown.js",
    "setupFiles": [
      "./tests/setupEnv.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
